# Vellum Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@postgres:5432/vellum
POSTGRES_USER=vellum_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=vellum

# Redis Configuration
REDIS_URL=redis://redis:6379

# Authentication
PRIVATE_BETTER_AUTH_SECRET=your_super_secret_auth_key_here
# Local development
PUBLIC_BETTER_AUTH_URL=http://localhost:5173
# Production domain (set this when deploying to vellum.chromitedev.xyz)
# PUBLIC_BETTER_AUTH_URL=https://vellum.chromitedev.xyz

# Google OAuth (for Google sign-in; email/password also works without it)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Set to true to show the "Continue with Google" button (requires the ID/secret above)
PUBLIC_GOOGLE_ENABLED=false

# SMTP (for password reset emails; e.g. Resend, Zoho, Gmail app password)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@vellum.chromitedev.xyz

# AWS S3/B2 Storage (for file uploads)
PRIVATE_B2_KEY_ID=your_b2_key_id
PRIVATE_B2_APP_KEY=your_b2_app_key
PUBLIC_B2_BUCKET=your_bucket_name
PUBLIC_B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com
PUBLIC_B2_REGION=us-west-002

# Polar.sh (for gem purchases / payments)
POLAR_ACCESS_TOKEN=your_polar_access_token
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret
PUBLIC_POLAR_PRODUCT_GEMS_500=your_polar_product_id_500
PUBLIC_POLAR_PRODUCT_GEMS_1300=your_polar_product_id_1300
PUBLIC_POLAR_PRODUCT_GEMS_2800=your_polar_product_id_2800
PUBLIC_POLAR_PRODUCT_GEMS_8000=your_polar_product_id_8000

# OpenAI (for AI features)
OPENROUTER_API_KEY=your_openrouter_api_key

# Websocket URL
# Local development
PUBLIC_WEBSOCKET_URL=ws://localhost:8080
# Production domain (routed through Caddy on /ws)
# PUBLIC_WEBSOCKET_URL=wss://vellum.chromitedev.xyz/ws